# =============================================================================
# VIXOR — Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to GitHub.
#
# Required vars are marked REQUIRED.
# Optional vars have fallback behavior documented.
# =============================================================================

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Birdeye (OPTIONAL) ───────────────────────────────────────────────────────
# Market data for Hunt domain (price, volume, market cap, holders).
# Free tier: https://birdeye.so
# Without this: graceful null fallback — market data shows "unavailable"
BIRDEYE_API_KEY=

# ── Birdeye API key (alternate name) ─────────────────────────────────────────
# Some parts of the codebase may reference this env var name
# BIRDEYE_KEY=

# ── OpenRouter (OPTIONAL) ────────────────────────────────────────────────────
# AI-powered chart analysis via OpenRouter.
# https://openrouter.ai/keys
# Without this: falls back to local SMC/ICT engine (no AI, deterministic)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ── Telegram Bot (OPTIONAL) ───────────────────────────────────────────────────
# Alerts and trade signals via Telegram.
# Get from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Binance (OPTIONAL — Testnet) ─────────────────────────────────────────────
# Paper trading via Binance testnet.
# Without this: local-only, no exchange integration
# Get testnet credentials: https://testnet.binance.vision/
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=true

# ── Wallet Connect (OPTIONAL) ───────────────────────────────────────────────
# For wallet-based authentication.
# https://cloud.walletconnect.com/
WALLETCONNECT_PROJECT_ID=

# ── Helius RPC (OPTIONAL) ────────────────────────────────────────────────────
# Enhanced Solana RPC with free tier.
# https://helius.xyz
# Without this: uses public Solana RPC
HELIUS_API_KEY=

# ── TradingView (OPTIONAL) ───────────────────────────────────────────────────
# TradingView charts integration.
# https://p.tradingview.com/account/
TV_EMBEDDED_CHARTS_KEY=

# ── Mixpanel (OPTIONAL) ──────────────────────────────────────────────────────
# Product analytics. Free tier: mixpanel.com
# Without this: analytics calls are no-ops
VITE_MIXPANEL_TOKEN=

# ── Sentry (OPTIONAL) ───────────────────────────────────────────────────────
# Error tracking & session replay. Free tier: sentry.io
# Get DSN from: https://sentry.io/settings/your-org/projects/vixor/keys/
# Without this: errors logged to console only (no-op in production)
VITE_SENTRY_DSN=
VITE_APP_ENV=development

# ── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to enable features still in beta
VITE_ENABLE_ALPHA_FEATURES=false
VITE_ENABLE_AI_ANALYSIS=true
VITE_ENABLE_REAL_TRADES=false   # Paper-only by default
