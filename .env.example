# ============================================================================
# VIXOR MASTER V2 — Environment Variables Template
# ============================================================================
# Copy this file to `.env` and fill in real values.
# All variables are required for the app to function correctly.
#
# Production values are set on Vercel (15 vars total).
# See: /home/z/my-project/audit/vixor_current_state.md §15 issue #1
# ============================================================================

# ── Supabase (5 vars) ──────────────────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...   # same as SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # server-only, NEVER expose to browser

# Browser-side mirrors (Vite needs the VITE_ prefix to expose them)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...

# ── Telegram Bot (3 vars) ──────────────────────────────────────────────────
# Get token from @BotFather. Bot username WITHOUT @.
TELEGRAM_BOT_TOKEN=1234567:ABC-DEF...
VITE_TELEGRAM_BOT_USERNAME=VixorAIBot
TELEGRAM_WEBHOOK_SECRET=<32-random-bytes-hex>   # generate: openssl rand -hex 32

# ── Market data providers (2 vars) ─────────────────────────────────────────
TWELVEDATA_API_KEY=<from https://twelvedata.com>
FINNHUB_API_KEY=<from https://finnhub.io>

# ── App secrets (1 var) ────────────────────────────────────────────────────
CRON_SECRET=<32-random-bytes-hex>   # protects /api/generate-signals + /api/check-alerts
HEALTH_TOKEN=<random-token>         # protects /api/metrics

# ── Credential encryption (Phase 1 — credential_crypto module) ──────────────
# 32-byte hex string used to derive an AES-256-GCM key for encrypting user
# API credentials at rest. Generate with: openssl rand -hex 32
# NEVER commit a real value to git. Rotate via the rotateKey() helper.
CREDENTIAL_ENCRYPTION_KEY=""

# ── LLM provider keys (Phase 1 — multi-provider LLMRouter) ──────────────────
# ZAI is the bundled default (no key needed). Set these to enable fallback
# providers or to override the default via LLM_PROVIDER.
LLM_PROVIDER=zai                      # zai | openai | anthropic | groq
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Optional base URL overrides (for proxies / self-hosted):
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Notification channels (Phase 1 — NotificationRouter) ────────────────────
# Telegram is already configured via TELEGRAM_BOT_TOKEN above. The following
# enable email (Resend) and webhook signing.
RESEND_API_KEY=                       # optional; if unset, email channel is skipped
RESEND_FROM=Vixor <noreply@vixor.app>
WEBHOOK_SIGNING_SECRET=               # optional HMAC-SHA256 secret for outgoing webhooks

# ── Feature flags (2 vars) ─────────────────────────────────────────────────
ENABLE_PAPER_TRADING=true
ENABLE_DEBATE_ENGINE=true

# ── Optional: Upstash Redis (only for multi-instance deploys) ──────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Prisma (local DB only — production uses Supabase) ──────────────────────
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Arbitrage Bot (Phase B.1 — ported from axiom-arbitrage) ──────────────────
# ALL arbitrage vars use ARBITRAGE_ prefix to avoid conflicts.
# Safety defaults: DRY_RUN=true, EXECUTION_ENABLED=false (no real funds moved)

ARBITRAGE_BOT_MODE=mock                       # mock (simulated) | live (real APIs)
ARBITRAGE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
ARBITRAGE_AXIOM_API_KEY=                       # optional — for Axiom terminal routing
ARBITRAGE_AXIOM_API_URL=https://api.axiom.trade
ARBITRAGE_JUPITER_QUOTE_URL=https://quote-api.jup.ag/v6
ARBITRAGE_SCAN_INTERVAL_MS=5000                # continuous scan interval (ms)
ARBITRAGE_MIN_PROFIT_BPS=15                    # minimum net profit in basis points
ARBITRAGE_MAX_SLIPPAGE_BPS=50                  # max slippage tolerance
ARBITRAGE_MAX_TRADE_SIZE_SOL=1                 # max trade size per opportunity (SOL)
ARBITRAGE_MAX_DAILY_TRADES=100                 # daily execution cap
ARBITRAGE_MAX_CONSECUTIVE_FAILURES=5           # circuit breaker threshold
ARBITRAGE_EXECUTION_ENABLED=false              # ⚠️ SET TO true ONLY after testing
ARBITRAGE_DRY_RUN=true                         # ⚠️ SET TO false ONLY after testing
ARBITRAGE_WALLET_PRIVATE_KEY=                  # Solana keypair (base58) — live mode only
ARBITRAGE_WATCH_TOKENS=SOL,USDC,BONK,WIF,JUP   # comma-separated tokens to scan
ARBITRAGE_LOG_LEVEL=info                       # debug | info | warn | error

# ── Wallet Hub (Phase B.2 — non-custodial wallet connections) ──────────────
# All wallet vars use WALLET_ prefix. No private keys are stored.
# JWT signing uses CREDENTIAL_ENCRYPTION_KEY (already defined above).
WALLET_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
WALLET_EVM_RPC_URL=https://eth.llamarpc.com
# WALLET_JWT_SECRET=<optional, falls back to CREDENTIAL_ENCRYPTION_KEY>

# ── Memecoin Discovery (Phase B.4 — token scoring pipeline) ──────────────
# All discovery vars use DISCOVERY_ prefix (or provider-specific prefixes).
# All API keys are optional — the pipeline degrades gracefully when missing.
BIRDEYE_API_KEY=                         # price/volume/liquidity data
HELIUS_RPC_URL=                           # Solana on-chain + smart money
HELIUS_API_KEY=                            # alternative to full RPC URL
TWITTER_BEARER_TOKEN=                      # social mentions (API v2)
LUNARCRUSH_API_KEY=                        # sentiment analysis
DEXSCREENER_API_URL=https://api.dexscreener.com/latest
DISCOVERY_SCAN_INTERVAL_S=30              # auto-refresh interval (seconds)
DISCOVERY_PRICE_CACHE_TTL_S=30            # price data cache TTL
DISCOVERY_SOCIAL_CACHE_TTL_S=300          # social data cache TTL (5 min)
DISCOVERY_MAX_TOKENS=100                  # max tokens per scan
DISCOVERY_ENABLED=true                    # master on/off switch
DISCOVERY_MIN_LIQUIDITY=10000             # min liquidity filter ($USD)
