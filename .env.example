# ============================================================================
# VIXOR MASTER V2 — Environment Variables Template
# ============================================================================
# Copy this file to `.env` and fill in real values.
# All variables are required for the app to function correctly.
#
# Production values are set on Vercel (15 vars total).
# See: /home/z/my-project/audit/vixor_current_state.md §15 issue #1
# ============================================================================

# ── Supabase (5 vars) ──────────────────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...   # same as SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # server-only, NEVER expose to browser

# Browser-side mirrors (Vite needs the VITE_ prefix to expose them)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...

# ── Telegram Bot (3 vars) ──────────────────────────────────────────────────
# Get token from @BotFather. Bot username WITHOUT @.
TELEGRAM_BOT_TOKEN=1234567:ABC-DEF...
VITE_TELEGRAM_BOT_USERNAME=VixorAIBot
TELEGRAM_WEBHOOK_SECRET=<32-random-bytes-hex>   # generate: openssl rand -hex 32

# ── Market data providers (2 vars) ─────────────────────────────────────────
TWELVEDATA_API_KEY=<from https://twelvedata.com>
FINNHUB_API_KEY=<from https://finnhub.io>

# ── App secrets (1 var) ────────────────────────────────────────────────────
CRON_SECRET=<32-random-bytes-hex>   # protects /api/generate-signals + /api/check-alerts
HEALTH_TOKEN=<random-token>         # protects /api/metrics

# ── Feature flags (2 vars) ─────────────────────────────────────────────────
ENABLE_PAPER_TRADING=true
ENABLE_DEBATE_ENGINE=true

# ── Optional: Upstash Redis (only for multi-instance deploys) ──────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Prisma (local DB only — production uses Supabase) ──────────────────────
DATABASE_URL=file:/home/z/my-project/db/custom.db
