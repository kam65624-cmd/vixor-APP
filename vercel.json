{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/generate-signals",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/check-alerts",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "src/routes/**/*.ts": {
      "maxDuration": 30
    },
    "api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
