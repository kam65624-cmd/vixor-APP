# VIXOR MASTER V2 — Local dev environment
# (secrets replaced with placeholders — fill in real values for local dev)
# Production values are set on Vercel.

# ── Database (local Prisma) ──
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Feature flags (safe to commit) ──
ENABLE_PAPER_TRADING=true
ENABLE_DEBATE_ENGINE=true

# ── Telegram bot username (public, safe) ──
VITE_TELEGRAM_BOT_USERNAME=VixorAIBot

